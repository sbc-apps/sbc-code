{
  "name": "sbc-code",
  "displayName": "SBC Code",
  "description": "Local-first autonomous VS Code coding agent with Ollama, Colibri, verified on-disk edits, checkpoints and optional code review.",
  "version": "0.9.0",
  "publisher": "sbc-apps",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "SBC",
    "Colibri",
    "local AI",
    "coding assistant",
    "offline"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:sbcCode.chatView",
    "onCommand:sbcCode.openChat",
    "onCommand:sbcCode.editSelection",
    "onCommand:sbcCode.explainSelection",
    "onCommand:sbcCode.setApiKey",
    "onCommand:sbcCode.selectModel",
    "onCommand:sbcCode.refreshModels",
    "onCommand:sbcCode.restoreLastEdit",
    "onCommand:sbcCode.fixDiagnostics",
    "onCommand:sbcCode.checkForUpdates"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sbcCode",
          "title": "SBC Code",
          "icon": "media/sbc-code.svg"
        }
      ]
    },
    "views": {
      "sbcCode": [
        {
          "id": "sbcCode.chatView",
          "name": "AI Assistant",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sbcCode.openChat",
        "title": "SBC Code: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sbcCode.editSelection",
        "title": "SBC Code: Edit Selection",
        "icon": "$(edit)"
      },
      {
        "command": "sbcCode.explainSelection",
        "title": "SBC Code: Explain Selection",
        "icon": "$(lightbulb)"
      },
      {
        "command": "sbcCode.setApiKey",
        "title": "SBC Code: Set API Key",
        "icon": "$(key)"
      },
      {
        "command": "sbcCode.selectModel",
        "title": "SBC Code: Select Model",
        "icon": "$(symbol-class)"
      },
      {
        "command": "sbcCode.refreshModels",
        "title": "SBC Code: Refresh Models",
        "icon": "$(refresh)"
      },
      {
        "command": "sbcCode.restoreLastEdit",
        "title": "SBC Code: Restore Last AI Edit",
        "icon": "$(discard)"
      },
      {
        "command": "sbcCode.fixDiagnostics",
        "title": "SBC Code: Fix Current File Diagnostics",
        "icon": "$(wrench)"
      },
      {
        "command": "sbcCode.checkForUpdates",
        "title": "SBC Code: Check for Updates",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sbcCode.editSelection",
          "when": "editorHasSelection",
          "group": "navigation@10"
        },
        {
          "command": "sbcCode.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@11"
        },
        {
          "command": "sbcCode.fixDiagnostics",
          "when": "resourceScheme == file",
          "group": "navigation@12"
        }
      ],
      "view/title": [
        {
          "command": "sbcCode.refreshModels",
          "when": "view == sbcCode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "sbcCode.selectModel",
          "when": "view == sbcCode.chatView",
          "group": "navigation@2"
        },
        {
          "command": "sbcCode.restoreLastEdit",
          "when": "view == sbcCode.chatView",
          "group": "navigation@3"
        },
        {
          "command": "sbcCode.checkForUpdates",
          "when": "view == sbcCode.chatView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "SBC Code",
      "properties": {
        "sbcCode.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000/v1",
          "description": "Base URL for Colibri/OpenAI-compatible provider. Ollama has its own sbcCode.ollamaBaseUrl."
        },
        "sbcCode.model": {
          "type": "string",
          "default": "",
          "description": "Optional fixed model ID for Colibri/OpenAI-compatible providers. Leave empty to use the sidebar picker."
        },
        "sbcCode.maxTokens": {
          "type": "integer",
          "default": 2048,
          "minimum": 64,
          "maximum": 16384,
          "description": "Maximum number of output tokens per request."
        },
        "sbcCode.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for chat and code edits."
        },
        "sbcCode.maxContextChars": {
          "type": "integer",
          "default": 12000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Maximum selected-code characters attached to a request; longer selections are rejected."
        },
        "sbcCode.allowInsecureRemote": {
          "type": "boolean",
          "default": false,
          "description": "Allow unencrypted HTTP connections to non-local servers. Not recommended when sending source code."
        },
        "sbcCode.inlineSuggestions": {
          "type": "boolean",
          "default": false,
          "description": "Enable optional AI inline ghost-text suggestions. Disabled by default because Colibri models on CPU may be slow."
        },
        "sbcCode.updateNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Check official SBC Code GitHub Releases when VS Code starts and every six hours, and notify when a newer stable version is available. No source code is sent."
        },
        "sbcCode.provider": {
          "type": "string",
          "default": "colibri",
          "enum": [
            "colibri",
            "ollama"
          ],
          "enumDescriptions": [
            "Colibri or another OpenAI-compatible server",
            "Ollama local model server"
          ],
          "description": "Default AI inference provider. The sidebar selector persists its choice in VS Code extension storage without writing User Settings; manual Settings changes are supported."
        },
        "sbcCode.ollamaBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server origin. Accepts http://127.0.0.1:11434 or an endpoint ending in /v1. Non-local servers require HTTPS unless explicitly allowed."
        },
        "sbcCode.ollamaModel": {
          "type": "string",
          "default": "",
          "description": "Optional fixed Ollama model name, e.g. qwen3-coder:latest. Leave empty to use the sidebar's model selection."
        },
        "sbcCode.agentEditMode": {
          "type": "string",
          "default": "automatic",
          "enum": [
            "automatic",
            "review"
          ],
          "enumDescriptions": [
            "Automatically create, edit and save files inside the trusted workspace",
            "Show diffs and ask approval before each edit"
          ],
          "description": "File edit policy for SBC Code Agent and Edit Selection. Automatic edits are restricted to a trusted local workspace. Terminal commands still require separate approval."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc --noEmit -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js && node --check media/chat.js",
    "package": "npm run compile && vsce package --no-dependencies",
    "smoke:colibri": "node scripts/colibri-smoke.mjs",
    "check:smoke": "node --check scripts/colibri-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.3"
  },
  "icon": "media/sbc-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbc-apps/sbc-code.git"
  },
  "homepage": "https://github.com/sbc-apps/sbc-code#readme",
  "bugs": {
    "url": "https://github.com/sbc-apps/sbc-code/issues"
  }
}
